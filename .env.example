# Server Port (default: 3000)
PORT=3000

# Server Host Binding (default in production: 127.0.0.1 for local security)
# Set to 0.0.0.0 only if you want to allow LAN or external reverse proxy access.
HOST=127.0.0.1

# Node environment
NODE_ENV=production

# Optional: GEMINI_API_KEY for AI-assisted animation breakdowns
# The studio is fully functional without this key.
GEMINI_API_KEY=""

# Application URL
APP_URL="http://127.0.0.1:3000"
